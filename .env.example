# Django Settings
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True

# Database Configuration
DB_NAME=gold_trading
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Kavenegar SMS API
KAVENEGAR_API_KEY=your-kavenegar-api-key

# Viragold live gold price (API values are Toman; backend stores Rial ×10)
# Token only — do not prefix with "Bearer"
VIRAGOLD_API_URL=https://api.viragold.net/api/v1/price
VIRAGOLD_API_TOKEN=
VIRAGOLD_SYMBOL_ID=1197
VIRAGOLD_TOMAN_TO_RIAL=10
VIRAGOLD_FETCH_INTERVAL=30

# Hosts / CORS / CSRF (production examples)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=False

# Runflare-safe defaults (override to /static/ and /media/ for local Docker+Nginx if needed)
STATIC_URL=/django-static/
MEDIA_URL=/django-media/

# Branding (backend — invoices, etc.)
BRAND_NAME=اپال‌باکس
BRAND_NAME_EN=OpalBox
BRAND_COMPANY_NAME=شرکت اپال‌باکس
# مسیر نسبی نسبت به backend/static/ — فایل باید داخل سرویس backend باشد
BRAND_INVOICE_LOGO=brand/OpalBox-mark.png

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=اپال‌باکس
NEXT_PUBLIC_BRAND_NAME_EN=OpalBox
NEXT_PUBLIC_BRAND_COMPANY_NAME=شرکت اپال‌باکس
NEXT_PUBLIC_BRAND_TAGLINE=سامانه امن خرید و فروش طلای آب‌شده
NEXT_PUBLIC_BRAND_LOGO=/OpalBox.png
NEXT_PUBLIC_BRAND_LOGO_MARK=/OpalBox-mark.png
NEXT_PUBLIC_THEME_COLOR=#D4AF37

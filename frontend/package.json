    "lucide-react": "^0.556.0",
    "next": "16.0.8",
    "react": "19.2.1",
    "react-date-object": "^2.1.9",
    "react-dom": "19.2.1",
    "react-hot-toast": "^2.6.0",
    "react-multi-date-picker": "^4.5.2",
    "react-to-print": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
